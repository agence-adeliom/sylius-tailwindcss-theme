{% set prefixes = hookable_metadata.prefixes|merge(['sylius_shop.shared.form']) %}
{% set form = hookable_metadata.context.form %}
{% set field = hookable_metadata.configuration.field %}

{% set autocomplete_section = field starts with 'billing' ? 'billing ' : (field starts with 'shipping' ? 'shipping ' : '') %}

{% hook 'address' with { _prefixes: prefixes, 'form': attribute(form, field), autocomplete_section } only %}
