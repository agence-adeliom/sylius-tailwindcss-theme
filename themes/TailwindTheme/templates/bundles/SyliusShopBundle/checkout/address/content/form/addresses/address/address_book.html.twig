{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Checkout\Address\AddressBookComponent #}

{% if addresses is not empty %}
    <div {{ attributes }} class="my-3">
        <div>
            <label class="block font-medium text-sm mb-1" for="address-book-{{ field }}">{{ 'sylius.ui.address_book'|trans }}</label>
            <select id="address-book-{{ field }}" class="select w-full h-auto min-h-10 py-2" data-model="addressId" {{ sylius_test_html_attribute('address-book') }}>
                <option value="" selected hidden>{{ 'sylius.ui.select'|trans }}</option>
                {% for address in addresses %}
                    <option value="{{ address.id }}">
                        {{ address.fullName }},{{ address.street }}, {{ address.city }} {{ address.postcode }}, {{ address.countryCode|sylius_country_name }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>
{% endif %}
