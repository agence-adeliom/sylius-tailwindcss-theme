{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block body %}
    <div class="flex flex-col min-h-screen overflow-hidden">
        <header role="banner" class="bg-base border-b border-neutral-300 py-4 ">
            <div class="container">
                <div class="flex gap-4 sm:gap-6 justify-between items-center">
                    {% hook 'sylius_shop.checkout.common.header' with {order} %}
                </div>
            </div>
        </header>
        <main id="main" role="main" tabindex="-1" class="relative flex grow flex-col focus:outline-none">
            <div class="container flex grow flex-col">
                {%- set is_complete = active_step == 'complete' -%}
                <div class="grid grow grid-cols-12 grid-rows-[auto_1fr] lg:grid-rows-1 tunnelHeight">
                    <div class="col-span-12 pt-4 pb-5{{ is_complete ? ' lg:col-start-2 lg:col-span-10' : ' lg:col-span-7 lg:pr-[5rem]' }}">
                        {% block content %}
                        {% endblock %}
                    </div>
                    {% block sidebar %}
                        {% if not is_complete %}
                            <div class="col-span-12 lg:col-span-5 relative py-5">
                                {% hook 'sylius_shop.checkout.common.sidebar' with {order} %}
                                <div class="left-1/2 max-lg:-translate-x-1/2 w-screen lg:left-0 lg:w-[50vw] h-full bg-neutral absolute top-0 z-1"></div>
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </main>
        {%- set footer_content -%}
            {% hook 'sylius_shop.checkout.common.footer' with {order} %}
        {%- endset -%}
        {#- Debug mode wraps an empty hook in BEGIN/END comments: the footer is rendered only around real content. -#}
        {% if not (footer_content matches '{^[[:space:]]*(?:<!--(?:(?!-->).)*-->[[:space:]]*)*$}s') %}
            <footer role="contentinfo" class="border-t border-neutral-300 py-6">
                <div class="container grid grid-cols-12 gap-6">
                    {{ footer_content }}
                </div>
            </footer>
        {% endif %}
    </div>
{% endblock %}
