{% set product = hookable_metadata.context.product %}

{# The link covers the whole card (::after), so the card holds a single link #}
<h3 class="font-semibold text-sm leading-snug transition-colors duration-200 group-hover:text-primary" {{ sylius_test_html_attribute('product-name', product.name) }}>
    <a
        class="link-reset after:absolute after:inset-0 after:rounded-lg focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-(--focus-ring-color)"
        href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale}) }}"
        {{ sylius_test_html_attribute('product-content') }}
    >{{ product.name }}</a>
</h3>
