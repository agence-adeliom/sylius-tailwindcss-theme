{% if app.session is not null and app.session.started %}
    {% for type in ['success', 'error', 'info', 'warning'] %}
        {% for flash in app.session.flashbag.get(type) %}
            {% set header = 'sylius.ui.' ~ type %}
            {% if type == 'error' %}
                {% set type = 'danger' %}
            {% endif %}

            <div class="alert alert-{{ type }} my-10 relative"{% if type == 'danger' %} role="alert"{% endif %} data-test-sylius-flash-message>
                {% from '@SyliusShop/shared/macro/icon.html.twig' import icon %}
                <div class="flex justify-between">
                    <p class="font-bold">{{ header|trans }}</p>
                    {#- Closing moves the focus to the next message, or to the main content (assets/js/flashes.js) -#}
                    <button type="button" class="btn btn-ghost btn-square btn-sm absolute right-4" data-flash-close aria-label="{{ 'app.ui.a11y.close'|trans }}">
                        {{ icon('x-mark') }}
                    </button>
                </div>
                <div {{ sylius_test_html_attribute('flash-messages') }}>
                    {% if flash is iterable %}
                        {{ flash.message|trans(flash.parameters, 'flashes') }}
                    {% else %}
                        {{ flash|trans({}, 'flashes') }}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endfor %}
{% endif %}
