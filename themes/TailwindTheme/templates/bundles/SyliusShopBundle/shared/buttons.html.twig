{% macro default(url, message, id, icon, class) %}
    {% from '@SyliusShop/shared/macro/icon.html.twig' import icon as render_icon %}
    <a class="btn {% if class is not empty %}{{ class }}{% endif %}" {% if id is not null %} id="{{ id }}"{% endif %} href="{{ url }}" {{ sylius_test_html_attribute('button', id|default(message)) }}>
        {% if icon is not empty %}
            {{ render_icon(icon) }}
        {% endif %}
        {% if message is not empty %}
            {{ message|trans }}
        {% endif %}
    </a>
{% endmacro %}

{% macro submit(message, id, icon, class, disabled=false) %}
    {% from '@SyliusShop/shared/macro/icon.html.twig' import icon as render_icon %}
    <button type="submit" class="btn {% if class is not empty %}{{ class }}{% endif %}" {% if id is not null %}id="{{ id }}"{% endif %} {{ sylius_test_html_attribute('button', id|default(message)) }} {% if disabled %}disabled="disabled"{% endif %}>
        {% if icon is not empty %}
            {{ render_icon(icon) }}
        {% endif %}
        {% if message is not empty %}
            {{ message|trans }}
        {% endif %}
    </button>
{% endmacro %}

{% macro transparent(url, message, id, icon, class, ariaLabel) %}
    {% from '@SyliusShop/shared/macro/icon.html.twig' import icon as render_icon %}
    <a href="{{ url }}" class="link-reset{% if class is not empty %} {{ class }}{% endif %}"{% if id is not null %} id="{{ id }}"{% endif %} {{ sylius_test_html_attribute('button', id|default(message)) }} {% if ariaLabel is not empty %} aria-label="{{ ariaLabel }}" {% endif %}>
        {% if icon is not empty %}
            {{ render_icon(icon) }}
        {% endif %}
        {% if message is not empty %}
            {{ message|trans }}
        {% endif %}
    </a>
{% endmacro %}

{% macro primary(url, message, id, icon) %}
    {{ _self.default(url, message, id, icon, 'btn-primary') }}
{% endmacro %}

{% macro secondary(url, message, id, icon) %}
    {{ _self.default(url, message, id, icon, 'btn-secondary') }}
{% endmacro %}

{% macro link(url, message, id, icon) %}
    {{ _self.default(url, message, id, icon, 'btn-link') }}
{% endmacro %}

{% macro delete(url, message, labeled=true, resourceId=null) %}
    {% from '@SyliusShop/shared/macro/icon.html.twig' import icon %}
    <form action="{{ url }}" method="post">
        <input type="hidden" name="_method" value="DELETE">
        <button class="btn btn-sm btn-danger  w-fit" type="submit" data-requires-confirmation {{ sylius_test_html_attribute('button', 'delete') }}>
            {{ icon('trash') }} {{ ((message is empty and labeled) ? 'sylius.ui.delete' : message)|trans }}
        </button>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(resourceId) }}" />
    </form>
{% endmacro %}
