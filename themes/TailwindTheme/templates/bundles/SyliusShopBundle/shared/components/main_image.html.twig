{% if product.imagesByType('thumbnail') is not empty %}
    {% set path = product.imagesByType('thumbnail').first.path|imagine_filter(filter|default('sylius_shop_product_thumbnail')) %}
{% elseif product.images.first %}
    {% set path = product.images.first.path|imagine_filter(filter|default('sylius_shop_product_thumbnail')) %}
{% else %}
    {% set path = asset('bundles/syliusui/images/200x200.png') %}
{% endif %}

{# Pass alt: '' when the product name is already next to the image #}
{% set alt = attributes.has('alt') ? attributes.all['alt'] : product.name %}

<img {{ attributes.without('alt', 'product').defaults({ class: 'max-w-full h-auto' }) }} src="{{ path }}" {{ sylius_test_html_attribute('main-image') }} alt="{{ alt }}" />