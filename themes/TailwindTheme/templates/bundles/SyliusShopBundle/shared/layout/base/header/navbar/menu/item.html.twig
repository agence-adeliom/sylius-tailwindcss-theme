{% set taxons = hookable_metadata.context.taxons %}
{% set variant = hookable_metadata.context.variant|default('desktop') %}

{% for taxon in taxons %}
    {% if taxon.enabledChildren|length > 0 %}
        <li class="relative" data-disclosure>
            {% hook 'item#dropdown' with {taxon, variant} %}
        </li>
    {% else %}
        {% hook 'item#link' with {taxon, variant} %}
    {% endif %}
{% endfor %}
