{% set taxon = hookable_metadata.context.taxon %}
<ul tabindex="{{ taxon.id }}" class="dropdown-content menu max-lg:!scale-100 max-lg:!opacity-100 max-lg:!block max-lg:!opacity-100 lg:bg-base-100 max-lg:!static lg:rounded-box !z-[100] lg:w-52 overflow-hidden !p-0 lg:top-full lg:left-1/2 lg:-translate-x-1/2 lg:shadow-sm">
    {% for child_taxon in taxon.enabledChildren %}
        <li class="w-full">
            <a class="flex items-center gap-4" href="{{ path('sylius_shop_product_index', {'slug': child_taxon.slug, '_locale': child_taxon.translation.locale}) }}" {{ sylius_test_html_attribute('menu-item', child_taxon.name) }}>
                {{ child_taxon.name }}
            </a>
        </li>
    {% endfor %}
</ul>
