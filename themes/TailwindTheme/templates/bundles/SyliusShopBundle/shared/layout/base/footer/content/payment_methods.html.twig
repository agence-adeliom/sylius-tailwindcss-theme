{% set new_window = 'sylius_tailwindcss.ui.a11y.new_window'|trans %}
<div class="col-span-full md:col-span-6 lg:col-span-3 flex flex-col gap-4">

    <div>
        <h2 id="footer-payment-methods-title" class="footer-title">{{ 'sylius.ui.payment_methods'|trans }}</h2>
        <ul role="list" class="flex flex-wrap gap-2" aria-labelledby="footer-payment-methods-title">
            {% for method in [
                {name: 'PayPal', url: 'https://sylius.com/partner/paypal/', logo: 'paypal-logo.svg'},
                {name: 'Adyen', url: 'https://sylius.com/partner/adyen/', logo: 'adyen-logo.svg'},
                {name: 'Mollie', url: 'https://sylius.com/partner/mollie/', logo: 'mollie-logo.svg'},
            ] %}
                <li>
                    <a href="{{ method.url }}" target="_blank" class="btn btn-ghost btn-sm px-2 h-auto py-1" aria-label="{{ method.name }} {{ new_window }}">
                        <img width="64" height="18" src="{{ asset('build/shop/images/' ~ method.logo, 'shop') }}" alt="" />
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-12">
        <ul role="list" class="flex gap-3" aria-label="{{ 'sylius_tailwindcss.ui.footer.social'|trans }}">
            {# Replace href="#" with the URLs of your social network pages #}
            {% for network, href in {instagram: '#', facebook: '#', x: '#'} %}
                <li>
                    <a class="btn btn-ghost btn-sm btn-square" href="{{ href }}" aria-label="{{ ('sylius_tailwindcss.ui.a11y.social.' ~ network)|trans }}">
                        {{ ux_icon('tabler:brand-' ~ network, {class: 'size-5'}) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

</div>
