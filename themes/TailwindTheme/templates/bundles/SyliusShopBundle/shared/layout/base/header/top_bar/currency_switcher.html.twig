{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Common\CurrencySwitcherComponent #}

{% if available_currencies|length > 1 %}
    <div class="col-auto">
        <div class="dropdown dropdown-hover" {{ sylius_test_html_attribute('currency-selector') }}>
            <div class="btn btn-sm" type="button" {{ sylius_test_html_attribute('active-currency') }}>
                {{ active_currency }}
            </div>
            <ul tabindex="-1" class="dropdown-content menu bg-base-100 text-base-content rounded-box z-1 w-52 p-2 shadow-sm">
                {% for code in available_currencies %}
                    {% if code is not same as(active_currency) %}
                        <li>
                            <a href="{{ path('sylius_shop_switch_currency', {'code': code}) }}" {{ sylius_test_html_attribute('available-currency') }}>
                                {{ code }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
