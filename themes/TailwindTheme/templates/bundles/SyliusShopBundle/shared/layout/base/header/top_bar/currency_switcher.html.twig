{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Common\CurrencySwitcherComponent #}

{% if available_currencies|length > 1 %}
    <div class="col-auto">
        <div class="relative" data-disclosure {{ sylius_test_html_attribute('currency-selector') }}>
            <button type="button" class="btn btn-sm" aria-expanded="false" aria-controls="currency-panel" aria-label="{{ 'app.ui.a11y.currency.button'|trans({'%value%': active_currency}) }}" {{ sylius_test_html_attribute('active-currency') }}>
                {{ active_currency }}
            </button>
            <ul id="currency-panel" role="list" hidden class="menu absolute end-0 top-full z-[100] w-52 rounded-box bg-base-100 p-2 text-base-content shadow-sm">
                {% for code in available_currencies %}
                    {% if code is not same as(active_currency) %}
                        <li>
                            <a href="{{ path('sylius_shop_switch_currency', {'code': code}) }}" {{ sylius_test_html_attribute('available-currency') }}>
                                {{ code }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
