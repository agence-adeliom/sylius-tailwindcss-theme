{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Common\CartComponent #}

<div {{ attributes }}>
    {% embed '@SyliusShop/shared/components/side_dialog.html.twig' with {
        id: 'cart-dialog',
        title: 'sylius.ui.cart'|trans,
        side: 'end',
        box_class: 'w-screen md:w-[500px] max-w-none',
        attributes: '',
        cart: cart,
    } %}
        {% block body %}
            {% hook 'cart' with {cart} %}
        {% endblock %}
    {% endembed %}
</div>
