{#- The project sets accessibility_statement.url and .label in its own translations; the theme only ships default_label. -#}
{%- set statement_url = 'sylius_tailwindcss.ui.a11y.accessibility_statement.url'|trans -%}
{%- set statement_label = 'sylius_tailwindcss.ui.a11y.accessibility_statement.label'|trans -%}
{%- if statement_label == 'sylius_tailwindcss.ui.a11y.accessibility_statement.label' -%}
    {%- set statement_label = 'sylius_tailwindcss.ui.a11y.accessibility_statement.default_label'|trans -%}
{%- endif -%}
<p class="col-span-full">
    {%- if statement_url is not empty and statement_url != 'sylius_tailwindcss.ui.a11y.accessibility_statement.url' -%}
        <a class="link link-hover" href="{{ statement_url }}">{{ statement_label }}</a>
    {%- else -%}
        {{ statement_label }}
    {%- endif -%}
</p>
