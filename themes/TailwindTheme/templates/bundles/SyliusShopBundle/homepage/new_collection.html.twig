<section class="container my-12" role="region" aria-labelledby="new-collection-heading">
    <h2 id="new-collection-heading" class="heading-4 mb-5">{{ 'sylius.homepage.new_collection'|trans }}</h2>

    {#
        Replace href="#" with your actual taxon URLs, e.g.:
        path('sylius_shop_product_index', {'slug': 'summer-collection'})
    #}
    {% set collections = [
        {key: 'new_arrivals', href: '#', image: 1, tall: true},
        {key: 'best_sellers', href: '#', image: 2, tall: false},
        {key: 'sale',         href: '#', image: 3, tall: false},
    ] %}

    <ul role="list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for item in collections %}
            <li class="{{ item.tall ? 'md:row-span-2' : '' }}">
                <a
                    href="{{ item.href }}"
                    class="group relative overflow-hidden rounded-2xl block"
                    style="aspect-ratio: {{ item.tall ? '3/4' : '16/9' }}"
                >
                    <img
                        src="{{ asset('build/shop/images/homepage-new-collection-photo-' ~ item.image ~ '.webp', 'shop') }}"
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                        alt=""
                    >
                    <div class="absolute inset-0 bg-gradient-to-t from-base-content/70 via-base-content/10 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-5 flex items-end justify-between">
                        <span class="text-white font-semibold text-lg drop-shadow">{{ ('sylius_tailwindcss.ui.homepage.collection.' ~ item.key)|trans }}</span>
                        <span aria-hidden="true" class="btn btn-sm btn-ghost text-white border-white/40 hover:bg-white/20 opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0">
                            {{ ux_icon('tabler:arrow-right', {class: 'size-4'}) }}
                        </span>
                    </div>
                </a>
            </li>
        {% endfor %}
    </ul>
</section>
