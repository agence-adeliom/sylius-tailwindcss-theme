{% set form = hookable_metadata.context.form %}
{% set item_label = hookable_metadata.context.item_label|default(hookable_metadata.context.item.productName) %}

<td>
    {{ form_row(form.quantity, sylius_test_form_attribute('cart-item-quantity')|sylius_merge_recursive({
        label: 'app.ui.a11y.cart.quantity'|trans({'%item%': item_label}),
        label_attr: {class: 'sr-only'},
        attr: {class: 'input w-full form-control'}
    })) }}
</td>
