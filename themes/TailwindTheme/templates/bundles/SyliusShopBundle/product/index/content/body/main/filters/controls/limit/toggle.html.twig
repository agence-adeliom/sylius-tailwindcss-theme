{#- A second rendering on the page passes a variant in the hook context, so that ids stay unique. -#}
{%- set panel_id = 'limit-panel' ~ (hookable_metadata.context.variant|default(null) ? '-' ~ hookable_metadata.context.variant : '') -%}
<button type="button" class="btn btn-sm btn-ghost border border-base-300" aria-expanded="false" aria-controls="{{ panel_id }}">
    <span class="text-base-content/60 text-xs">{{ 'sylius.ui.show'|trans }}:</span>
    <span>{{ hookable_metadata.context.resources.data.maxPerPage }}</span>
    {{ ux_icon('tabler:chevron-down', {class: 'size-3 opacity-60'}) }}
</button>
