{#- A second rendering on the page passes a variant in the hook context, so that ids stay unique. -#}
{%- set panel_id = 'limit-panel' ~ (hookable_metadata.context.variant|default(null) ? '-' ~ hookable_metadata.context.variant : '') -%}
{% set resources = hookable_metadata.context.resources %}
{% set pagination_limits = (resources.definition.limits) %}
<ul id="{{ panel_id }}" role="list" hidden class="menu absolute end-0 top-full mt-1 bg-base-100 rounded-box shadow-lg w-28 z-10">
    {% for limit in pagination_limits|filter(limit => limit != resources.data.maxPerPage) %}
        {% set path = path(app.request.attributes.get('_route'), app.request.attributes.all('_route_params')|merge(app.request.query.all)|merge({'limit': limit})) %}
        <li><a href="{{ path }}#products">{{ limit }}</a></li>
    {% endfor %}
</ul>
