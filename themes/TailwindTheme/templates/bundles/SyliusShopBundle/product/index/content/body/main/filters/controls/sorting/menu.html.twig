{#- A second rendering on the page passes a variant in the hook context, so that ids stay unique. -#}
{%- set panel_id = 'sorting-panel' ~ (hookable_metadata.context.variant|default(null) ? '-' ~ hookable_metadata.context.variant : '') -%}
<ul id="{{ panel_id }}" role="list" hidden class="menu absolute end-0 top-full mt-1 bg-base-100 rounded-box shadow-lg w-52 z-10">
    {% hook 'menu' %}
</ul>
