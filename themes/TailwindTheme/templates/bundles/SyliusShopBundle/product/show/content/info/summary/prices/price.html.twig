<div class="mb-2" {{ attributes }}>
    <div class="flex gap-3 items-center">
        <div class="heading-4" data-price-announce="{{ price }}" {{ sylius_test_html_attribute('product-price', price) }}>{% if has_discount %}<span class="sr-only">{{ 'app.ui.a11y.price.current'|trans }}</span> {% endif %}{{ price }}</div>
        {% if has_discount %}
            <div {{ sylius_test_html_attribute('product-original-price', original_price) }}>
                <span class="sr-only">{{ 'app.ui.a11y.price.original'|trans }}</span> <del>{{ original_price }}</del>
            </div>
        {% endif %}
    </div>
</div>
