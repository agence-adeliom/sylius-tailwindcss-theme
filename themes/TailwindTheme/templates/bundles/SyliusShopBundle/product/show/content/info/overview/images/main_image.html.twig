{% set product = hookable_metadata.context.product %}

<div class="w-full">
    <a href="{{ hookable_metadata.context.original_path }}" class="block overflow-hidden rounded">
        <img src="{{ hookable_metadata.context.path }}" alt="{{ product.name }}" class="img-fluid w-full h-full object-cover"
            {% if product.images.first %}
                {{ sylius_test_html_attribute('main-image', product.images.first.type) }}
            {% else %}
                {{ sylius_test_html_attribute('main-image') }}
            {% endif %}
        />
    </a>
</div>
